# Eboora-Store — Cloudflare Pages environment reference
SITE_URL=https://eboora.store
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
PRODUCT_PRICE_INR=499
PRODUCT_CURRENCY=INR
PRODUCT_ID=eboora-product
PRODUCT_NAME=Replace with the actual product name
PRODUCT_FILENAME=digital-product-download.zip
PRODUCT_FILE_KEY=digital-product-download.zip
FROM_EMAIL=Eboora-Store <downloads@eboora.store>
REPLY_TO=support@eboora.store
BRAND_NAME=Eboora-Store
# Required as encrypted secrets in Cloudflare; never commit actual secrets:
# CASHFREE_APP_ID=...
# CASHFREE_SECRET_KEY=...
# CASHFREE_WEBHOOK_SECRET=...
# DOWNLOAD_TOKEN_SECRET=...
# RESEND_API_KEY=...
# META_CAPI_TOKEN=...
# Optional:
# META_PIXEL_ID=123456789
# META_TEST_CODE=TEST123
# Owner login: email (variable) and password hash (secret). Make the hash with: node scripts/make-admin-password.mjs
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_HASH=...
# Where new-sale alerts go (your email). Optional: falls back to the support email in the admin settings.
# OWNER_EMAIL=you@example.com
