/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://sdk.cashfree.com https://*.cashfree.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.cashfree.com https://www.facebook.com https://connect.facebook.net; frame-src https://*.cashfree.com https://www.facebook.com; form-action 'self' https://*.cashfree.com; base-uri 'none'; frame-ancestors 'none'; report-uri /api/csp-report

/api/*
  Cache-Control: no-store

/admin.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'

/admin.js
  Cache-Control: no-store

/product.html
  Cache-Control: no-cache

/landing.js
  Cache-Control: no-cache
